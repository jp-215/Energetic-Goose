# Canopy Wave inference credentials
CANOPYWAVE_API_KEY=your-key-here
CANOPYWAVE_BASE_URL=https://inference.canopywave.io/v1

# Optional role -> model overrides (defaults are in app/config.py).
# Defaults use the models the demo key can access (kimi-k2.6, minimax-m3).
# Once your plan unlocks them, the original prototype cast was:
# COURT_SIMPLE_MODEL=moonshotai/kimi-k2.7-code-highspeed
# COURT_COMPLEX_MODEL=moonshotai/kimi-k3
# COURT_JUDGE_MODEL=xiaomimimo/mimo-v2.5

# Coding Hub role -> model overrides (defaults in app/core/config.py: DEFAULT_HUB_MODELS)
# HUB_PLANNER_MODEL=minimax/minimax-m3
# HUB_ENGINEER_MODEL=moonshotai/kimi-k2.6
# HUB_INTEGRATOR_MODEL=minimax/minimax-m3
# Where "Export to workspaces/" writes runs (default: <repo>/workspaces)
# HUB_WORKSPACES_DIR=

# ---- Model evaluation (optional) --------------------------------------------
# Model that plays the persona agents (asks questions, writes feedback).
# Defaults to the judge model so it is always accessible on the key.
# EVAL_SIMULATOR_MODEL=minimax/minimax-m3
# Fake every model call (or set CANOPYWAVE_API_KEY=mock) to demo without credits.
# EVAL_MOCK=1
# Where sessions / personas / the fallback graph are stored (default: var/).
# EVAL_DATA_DIR=./var

# Neo4j for the agent <-> model interaction graph. Leave unset to use the
# in-memory graph (same schema). See docker-compose.neo4j.yml at the repo root.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=evaluation
# NEO4J_DATABASE=neo4j
